#!/bin/sh
set -eu

restore_probe_engine() {
  src="/var/jb/Library/Application Support/OmarAutoMode"
  dst="/var/jb/Library/MobileSubstrate/DynamicLibraries"
  [ -f "$src/OmarAutoMode.dylib" ] || return 0
  mkdir -p "$dst"
  cp -f "$src/OmarAutoMode.dylib" "$dst/OmarAutoMode.dylib"
  cp -f "$src/OmarAutoMode.plist" "$dst/OmarAutoMode.plist"
}

cleanup_external_theme_bridge() {
  root="/var/mobile/Library/OmarAutoMode"
  theme="/var/jb/Library/Themes/Omar Auto Mode Active.theme"
  backup="$root/FormerExternalActive.theme"

  mkdir -p "$root"
  chown -R mobile:mobile "$root" 2>/dev/null || true

  if [ -L "$theme" ]; then
    rm -f "$theme"
  elif [ -d "$theme" ]; then
    rm -rf "$backup"
    mv "$theme" "$backup" 2>/dev/null || true
    chown -R mobile:mobile "$backup" 2>/dev/null || true
  fi
}

request_respring() {
  [ -n "${CYDIA:-}" ] || return 0
  read -r fd ver <<EOT
$CYDIA
EOT
  [ "${ver:-0}" -ge 1 ] || return 0
  echo "finish:restart" >&"$fd" || true
}

restore_probe_engine
cleanup_external_theme_bridge
request_respring
exit 0
