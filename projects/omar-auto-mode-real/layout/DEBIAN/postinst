#!/bin/sh
set -eu

restore_probe_engine() {
  src="/var/jb/Library/Application Support/OmarAutoMode"
  dst="/var/jb/Library/MobileSubstrate/DynamicLibraries"
  [ -f "$src/OmarAutoMode.dylib" ] || return 0
  mkdir -p "$dst"
  cp -f "$src/OmarAutoMode.dylib" "$dst/OmarAutoMode.dylib"
  cp -f "$src/OmarAutoMode.plist" "$dst/OmarAutoMode.plist"
}

prepare_snowboard_bridge() {
  root="/var/mobile/Library/OmarAutoMode"
  old_active="$root/ActiveSnowBoard.theme"
  themes="/var/jb/Library/Themes"
  active="$themes/Omar Auto Mode Active.theme"

  mkdir -p "$root" "$themes"
  chown -R mobile:mobile "$root" 2>/dev/null || true

  if [ -L "$active" ]; then
    rm -f "$active"
  elif [ -e "$active" ] && [ ! -d "$active" ]; then
    backup="$active.backup"
    i=1
    while [ -e "$backup" ]; do
      backup="$active.backup.$i"
      i=$((i + 1))
    done
    mv "$active" "$backup" 2>/dev/null || rm -f "$active"
  fi

  mkdir -p "$active"
  if [ -d "$old_active" ] && [ -z "$(ls -A "$active" 2>/dev/null)" ]; then
    cp -R "$old_active"/. "$active"/ 2>/dev/null || true
  fi
  chown -R mobile:mobile "$active" 2>/dev/null || true
}

request_respring() {
  [ -n "${CYDIA:-}" ] || return 0
  read -r fd ver <<EOT
$CYDIA
EOT
  [ "${ver:-0}" -ge 1 ] || return 0
  echo "finish:restart" >&"$fd" || true
}

restore_probe_engine
prepare_snowboard_bridge
request_respring
exit 0
