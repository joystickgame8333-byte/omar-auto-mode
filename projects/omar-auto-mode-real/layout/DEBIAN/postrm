#!/bin/sh
set -eu

remove_springboard_engine() {
  rm -f /var/jb/Library/MobileSubstrate/DynamicLibraries/OmarAutoMode.dylib
  rm -f /var/jb/Library/MobileSubstrate/DynamicLibraries/OmarAutoMode.plist
  rm -f /Library/MobileSubstrate/DynamicLibraries/OmarAutoMode.dylib
  rm -f /Library/MobileSubstrate/DynamicLibraries/OmarAutoMode.plist
}

remove_snowboard_bridge_link() {
  link="/var/jb/Library/Themes/Omar Auto Mode Active.theme"
  [ -L "$link" ] && rm -f "$link"
}

request_respring() {
  [ -n "${CYDIA:-}" ] || return 0
  read -r fd ver <<EOT
$CYDIA
EOT
  [ "${ver:-0}" -ge 1 ] || return 0
  echo "finish:restart" >&"$fd" || true
}

remove_springboard_engine
remove_snowboard_bridge_link
request_respring
exit 0
